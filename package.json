{
  "name": "vsync-client",
  "productName": "Vsync Client",
  "version": "0.1.3",
  "description": "Launcher independente para Minecraft Java Edition, com perfis isolados e Vsync HUD.",
  "author": "Vsync",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win dir --x64 && node scripts/package-nsis.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "compile:module": "node scripts/build-module.mjs",
    "test:ui": "npm run build && node tests/ui-smoke.mjs",
    "test:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows.ps1",
    "release:manifest": "node --import tsx scripts/release-manifest.mjs",
    "dist:win:signed": "npm run build && electron-builder --win nsis --x64 --config.win.signExecutable=true --config.forceCodeSigning=true",
    "test:official-network": "node --import tsx scripts/test-official-network.mjs",
    "test:performance-network": "node --import tsx scripts/test-performance-network.mjs",
    "test:site": "node --test services/web/test/*.test.mjs",
    "test:site:ui": "node tests/website-ui.mjs",
    "site": "node services/web/server.mjs",
    "updates:setup": "node scripts/setup-signing.mjs",
    "updates:configure": "node scripts/configure-updates.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "test:update-installer": "node --import tsx tests/update-install-native.mjs"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.vsync.client",
    "productName": "Vsync Client",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "module-artifacts",
        "to": "module-artifacts",
        "filter": [
          "*.jar",
          "README.md"
        ]
      },
      {
        "from": "docs/licenses",
        "to": "licenses",
        "filter": [
          "*.txt"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Vsync-Client-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    }
  }
}
